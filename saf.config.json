{
  "$schema": "tools/saf/schema/saf.config.schema.json",
  "version": 1,
  "project": {
    "name": "Super Agent Framework",
    "pitch": "A card-and-milestone workflow for Claude Code: proof before done, a reviewer who is not the builder, plans big work cannot drift from.",
    "type": "library-cli",
    "domain": "",
    "users": "developers who build with Claude Code",
    "stage": "mvp",
    "rigor": "standard"
  },
  "people": {
    "ownerTitle": "owner",
    "docLanguage": "en",
    "chatLanguage": "th",
    "uiLanguages": [
      "en",
      "th"
    ],
    "i18nRequired": false,
    "timeZone": "UTC"
  },
  "stack": {
    "summary": "Node >= 20 ESM, zero dependencies, node:test",
    "packageManager": "npm",
    "monorepo": false,
    "commands": {
      "typecheck": "",
      "lint": "",
      "test": "npm test",
      "e2e": "npm run test:e2e",
      "build": "",
      "testFiles": "node --test {files}"
    },
    "database": "none",
    "submodules": false
  },
  "models": {
    "preset": "balanced",
    "planner": "claude-opus-5-5",
    "builder": "claude-sonnet-5-5",
    "sessionDefault": "claude-opus-5-5",
    "effort": "by-size",
    "overrides": {}
  },
  "roles": {
    "enabled": [
      "designer",
      "spec-reviewer",
      "implementer",
      "qa-runner",
      "release-operator"
    ],
    "custom": [],
    "reportLanguage": "en"
  },
  "skills": {
    "packs": []
  },
  "workflow": {
    "sizes": {
      "S": 150,
      "M": 400
    },
    "testCaps": {
      "S": 250,
      "M": 600
    },
    "review": "every-card",
    "selfFix": "on",
    "lanes": {
      "code": 3,
      "main": 1
    },
    "sideLanes": {
      "enabled": true,
      "max": 1
    },
    "worktrees": true,
    "worktreeDir": ".claude/worktrees",
    "branchPrefix": "card/",
    "solo": [],
    "laneInstall": "",
    "lanePorts": {
      "base": 3000,
      "step": 10,
      "env": [
        "PORT"
      ]
    },
    "laneDb": "",
    "mergeChecks": [
      "npm run saf:refresh -- --check",
      "npm test",
      "npm run check-secrets",
      "npm run docs:check"
    ],
    "mergeInstall": {
      "cmd": "",
      "files": []
    },
    "measure": {
      "enabled": false,
      "waitMs": 1200000,
      "maxLoadPerCore": 0.5,
      "names": {
        "test": {
          "idle": false
        },
        "e2e": {
          "idle": false
        },
        "perf": {
          "idle": true
        },
        "adhoc": {
          "idle": true
        }
      }
    },
    "perfBudgets": "",
    "alwaysAllowed": [
      "tools/saf/**",
      ".claude/skills/saf-setup/**",
      ".saf/manifest.json",
      "examples/todo-api/tools/saf/**",
      "examples/todo-api/.claude/commands/**",
      "examples/todo-api/.claude/skills/**",
      "examples/todo-api/.claude/agents/**",
      "examples/todo-api/CLAUDE.md",
      "examples/todo-api/.saf/manifest.json",
      "docs/plan/friction.md",
      "docs/plan/friction.md.lock"
    ],
    "commandTimeoutMs": 1800000,
    "testMode": "targeted"
  },
  "policies": {
    "push": "owner-order",
    "deploy": {
      "mode": "owner-order",
      "target": "npm publish (super-agent-framework, create-saf) and GitHub releases",
      "exceptions": ""
    },
    "protectedBranches": [
      "main"
    ],
    "autoDeployBranches": [],
    "noForcePush": true,
    "secrets": {
      "envFiles": [
        ".env",
        ".env.local",
        ".env.*.local"
      ],
      "extraPatterns": []
    },
    "forbiddenPaths": [],
    "ownerOnlyPaths": [],
    "externalServices": [],
    "noTimeEstimates": true,
    "evidenceRequired": true
  },
  "tokenSaving": {
    "enabled": true,
    "silentInterim": true,
    "batchReviewerNotes": true,
    "reviewerDiff": true,
    "fixFlakyFirst": true
  },
  "firstMilestone": {
    "goal": "v0.1.0 public release: both npm packages published, GitHub release v0.1.0, first outside feedback triaged"
  }
}
