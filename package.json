{
  "name": "super-agent-framework",
  "version": "0.1.0",
  "description": "A card-and-milestone workflow for Claude Code: proof before \"done\", a reviewer that is not the builder, and plans that big work cannot drift from.",
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "agentic-workflow",
    "workflow",
    "milestones",
    "tdd",
    "code-review",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/Bellero-Advanced/super-agent-framework#readme",
  "bugs": {
    "url": "https://github.com/Bellero-Advanced/super-agent-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bellero-Advanced/super-agent-framework.git"
  },
  "license": "MIT",
  "author": "Bellero Advanced",
  "type": "module",
  "bin": {
    "saf": "bin/cli.mjs",
    "super-agent-framework": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "kit/",
    "README.md",
    "README.th.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:package": "node scripts/test.mjs package",
    "saf": "node tools/saf/bin/saf.mjs",
    "task:start": "node tools/saf/bin/saf.mjs task start",
    "task:verify": "node tools/saf/bin/saf.mjs task verify",
    "task:abandon": "node tools/saf/bin/saf.mjs task abandon",
    "task:merge": "node tools/saf/bin/saf.mjs task merge",
    "task:state": "node tools/saf/bin/saf.mjs task state",
    "task:next": "node tools/saf/bin/saf.mjs task next",
    "task:probe": "node tools/saf/bin/saf.mjs task probe",
    "task:env": "node tools/saf/bin/saf.mjs task env",
    "task:report": "node tools/saf/bin/saf.mjs task report",
    "docs:check": "node tools/saf/bin/saf.mjs docs-check",
    "spec:matrix": "node tools/saf/bin/saf.mjs spec-matrix",
    "check-secrets": "node tools/saf/bin/saf.mjs check-secrets",
    "saf:refresh": "node bin/cli.mjs upgrade --dir ."
  }
}
