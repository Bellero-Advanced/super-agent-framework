{
  "name": "super-agent-framework",
  "version": "0.1.0",
  "description": "SAF — a card-and-milestone workflow for Claude Code: roles, gates, evidence and a setup interview for any project",
  "type": "module",
  "private": true,
  "bin": {
    "super-agent-framework": "bin/cli.mjs",
    "saf": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "kit/",
    "README.md",
    "README.th.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.test.mjs\""
  }
}
